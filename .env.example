# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RapidAPI - Realty-in-AU
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=realty-in-au.p.rapidapi.com

# ── AI Providers (at least ONE required) ──────────────
# The app tries providers in order: OpenAI → Gemini → OpenRouter
# Add as many as you like for automatic fallback.

# OpenAI (optional) — https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Google Gemini (optional, free tier: 15 RPM) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter (optional, has free models) — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# Default model for OpenRouter (optional, defaults to google/gemini-2.0-flash-exp:free)
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
